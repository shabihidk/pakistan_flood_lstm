# Backend / inference host — copy to .env and fill in (never commit .env)
#
# SECURITY:
# - SUPABASE_SERVICE_ROLE_KEY bypasses RLS — backend and batch scripts ONLY.
# - Never prefix secrets with VITE_ (those are embedded in the frontend bundle).
# - Do not reuse the service role key in frontend/.env.

SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

MODEL_DIR=./models/flood_lstm_v4
MODEL_VERSION=Flood_LSTMV4
FLASK_DEBUG=false
